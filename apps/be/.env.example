# Application Configuration
APP_ENV=development
PORT=8080

# Admin Panel Configuration (GoAdmin Dashboard)
# In production, ENABLE_ADMIN defaults to false unless explicitly set to true.
# If ENABLE_ADMIN is enabled in production, provide strong ADMIN_USERNAME and ADMIN_PASSWORD.
ENABLE_ADMIN=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# CORS Configuration (comma-separated whitelist for production)
# In development, leave empty to allow all origins dynamically
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=ticketbox_db
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=1h
DB_CONN_MAX_IDLE_TIME=5m

# JWT Authentication Configuration
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
