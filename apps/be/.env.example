# Application Configuration
APP_ENV=development
PORT=8080

# CORS Configuration (comma-separated whitelist for production)
# In development, leave empty to allow all origins dynamically
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=ticketbox_db
DB_SSLMODE=disable
